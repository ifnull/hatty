# Secrets — never commit a Home Assistant token
*.token
.env
.env.*
secrets.toml
config.local.*
**/config.local.*

# Local dashboard configs may contain host names / tokens
dashboards/local/

# Runtime
*.log
logs/
__pycache__/
*.py[cod]
.venv/
venv/

# Go
/bin/
/dist/
*.test

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Spike artifacts — generated keys must never be committed
docs/spikes/**/.ssh/
spike_host_key
spike_host_key.pub
*_ed25519
*_ed25519.pub
docs/spikes/S8-wish-bubbletea/s8probe

# Raw HA captures are location data (D27) -- only sanitised fixtures may be committed
*-raw.jsonl
hatty-fixtures/
docs/spikes/fixtures/*-raw.jsonl
